{
  "$schema": "https://json.schemastore.org/package",
  "name": "michaili.dev",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@ili/configs": "workspace:*",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error",
      "version": ">=26"
    },
    "packageManager": {
      "name": "pnpm",
      "onFail": "error",
      "version": ">=11"
    }
  }
}
