{
  "name": "michaili.dev",
  "private": true,
  "scripts": {
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.5.3"
  },
  "engines": {
    "node": ">=26"
  },
  "devEngines": {
