{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@ili/configs",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./eslint/*": "./eslint/*.ts",
    "./prettier/*": "./prettier/*.ts",
    "./tsconfig/*": "./tsconfig/*.json"
  },
  "scripts": {
    "format": "prettier -w .",
    "lint": "eslint . --max-warnings 0 --flag unstable_native_nodejs_ts_config",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "catalog:",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.13.0",
    "prettier-plugin-packagejson": "^3.0.3",
    "typescript-eslint": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "prettier": "catalog:"
  }
}
